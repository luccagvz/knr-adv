# Copie para .env (não commitado) para rodar o build localmente com notícias do CMS.
# Em produção (Netlify) estas mesmas chaves são configuradas em
# Site settings → Environment variables — o build lê de process.env normalmente.

# Project Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Project Settings → API → Project API keys → anon / public
# Segura de expor: é protegida por Row Level Security no banco.
SUPABASE_ANON_KEY=
